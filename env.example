# -----------------------------
# MLOps stack example variables
# -----------------------------
# Non-production demo values only.

# app-db
APP_DB_DATA=./mlops_app_db_data
APP_DB_NAME=app_db
APP_DB_PASSWORD=app_password_demo
APP_DB_PORT=5436
APP_DB_USER=app_user

# mlflow postgres
MLFLOW_DB_DATA=./mlops_mlflow_db_data
POSTGRES_DB_MLFLOW=mlflow_db
POSTGRES_PASSWORD_MLFLOW=mlflow_password_demo
POSTGRES_PORT_MLFLOW=6432
POSTGRES_USER_MLFLOW=mlflow_user

# mlflow service
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MINIO_BUCKET=mlflow

# minio
MINIO_CONSOLE_PORT=9023
MINIO_DATA=./mlops_minio_data
MINIO_PORT=9022
MINIO_ROOT_PASSWORD=minio_password_demo
MINIO_ROOT_USER=minio_user_demo

# monitoring
PROMETHEUS_PORT=9091
LOKI_PORT=3100
PROMTAIL_PORT=9080
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_demo_password

# autoserve/model settings
MLFLOW_SERVE_ALIASES=Production,Test
MLFLOW_SERVE_POLL_SECONDS=30
MODEL_NAME=my_model
MODEL_SERVER_PORT=8003
