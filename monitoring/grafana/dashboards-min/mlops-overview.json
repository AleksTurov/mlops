{
  "title": "MLOps Overview",
  "uid": "mlops-overview",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "table",
      "title": "Service Up",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 8},
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "up",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "stat",
      "title": "Served Model Targets Up",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 6},
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(probe_success{job=\"blackbox-mlflow-serve\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Served Model Targets Down",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 6},
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(probe_success{job=\"blackbox-mlflow-serve\"} == 0)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Logs (All MLOps Containers)",
      "gridPos": {"x": 0, "y": 14, "w": 24, "h": 10},
      "datasource": "Loki",
      "targets": [
        {
          "expr": "{service=~\"airflow-db|airflow-scheduler|airflow-webserver|app-db|blackbox-exporter|grafana|loki|minio|mlflow|mlflow-autoserve|mlflow-db|mlflow-serve|prometheus|promtail\"}",
          "refId": "A"
        }
      ]
    }
  ],
  "annotations": {"list": []},
  "templating": {"list": []}
}
